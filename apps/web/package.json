    "@react-pdf/renderer": "^4.9.0",
    "@vercel/blob": "^2.8.0",
    "ai": "^7.0.99",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.46.0",
    "mammoth": "^1.12.3",
    "next": "16.3.5",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
