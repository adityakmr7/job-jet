# Job Jet web app (apps/web) environment.
# Copy to .env.local for local development (`npm run dev` on port 3001).
# In production, set these in Vercel -> Project -> Settings -> Environment Variables.
# Every variable below is REQUIRED unless marked optional.

# --- Database (Neon Postgres) ------------------------------------------------
# Pooled connection string from the Neon console / Vercel Neon integration.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- AI (Google Gemini via the AI SDK) ---------------------------------------
# Used for resume parsing, resume tailoring, and autofill field matching.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Auth (Clerk) ------------------------------------------------------------
# From the Clerk dashboard -> API keys. Use pk_live_/sk_live_ in production.
# The extension's VITE_CLERK_PUBLISHABLE_KEY must be the same publishable key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Optional: tell Clerk where the custom sign-in/up pages live.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- File storage (Vercel Blob) ----------------------------------------------
# Read/write token for a *private* Blob store (resumes are private).
# Created automatically when you connect a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# --- CORS for the Chrome extension --------------------------------------------
# Comma-separated Chrome extension IDs allowed to call the API cross-origin
# (see chrome://extensions). Include the Chrome Web Store ID and, if you use
# one against this environment, your unpacked dev build's ID.
# Development: if empty, any chrome-extension:// origin is allowed.
# Production:  if empty, ALL extension requests are rejected (fail closed).
ALLOWED_EXTENSION_IDS=
