# Job Jet web app (apps/web) environment.
# Copy to .env.local for local development (`npm run dev` on port 3001).
# In production, set these in Vercel -> Project -> Settings -> Environment Variables.
# Every variable below is REQUIRED unless marked optional.

# --- Database (Neon Postgres) ------------------------------------------------
# Pooled connection string from the Neon console / Vercel Neon integration.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- AI (Google Gemini via the AI SDK) ---------------------------------------
# Used for resume parsing, resume tailoring, and autofill field matching.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Auth (Better Auth, accounts stored in DATABASE_URL) ---------------------
# Secret used to sign session cookies/tokens. 32+ random characters, e.g.
#   openssl rand -base64 32
# Use a different value per environment. Rotating it signs everyone out.
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
# Public origin of this app (no trailing slash). Used for OAuth callbacks,
# email links and the CSRF/origin check.
# Local: http://localhost:3001   Production: https://<your-domain>
BETTER_AUTH_URL=http://localhost:3001

# Optional: "Continue with Google". Both must be set or the button is hidden.
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorized redirect URIs:
#   https://<your-domain>/api/auth/callback/google
#   http://localhost:3001/api/auth/callback/google
# See the README ("Google sign-in setup").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (optional: verification + password-reset emails) -------------------
# With RESEND_API_KEY set, emails are sent through Resend (https://resend.com)
# and email verification is REQUIRED before password sign-in.
# Without it, emails are printed to the server console in development only
# (never in production), and email verification is NOT enforced — see README
# "Email verification tradeoff". Password reset needs an email provider in
# production.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Job Jet <no-reply@yourdomain.com>".
# Defaults to Resend's sandbox sender (only delivers to your own address).
EMAIL_FROM=

# --- File storage (Vercel Blob) ----------------------------------------------
# Read/write token for a *private* Blob store (resumes are private).
# Created automatically when you connect a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# --- Chrome extension access -------------------------------------------------
# Comma-separated Chrome extension IDs allowed to connect to accounts (receive
# a session token on /extension-connect), use bearer tokens, and call the API
# cross-origin (see chrome://extensions). Include the Chrome Web Store ID and, if you use
# one against this environment, your unpacked dev build's ID.
# Development: if empty, any chrome-extension:// origin is allowed.
# Production:  if empty, the extension can't connect at all (fail closed).
ALLOWED_EXTENSION_IDS=

# --- Legal pages (optional but needed before publishing) ----------------------
# Contact address shown on /privacy and /terms for privacy/data requests.
NEXT_PUBLIC_CONTACT_EMAIL=

# Chrome Web Store listing URL, once published (landing-page "Add to Chrome"
# buttons fall back to /sign-up while unset).
NEXT_PUBLIC_EXTENSION_URL=
