# Job Jet extension environment.
#
# Vite inlines VITE_* values into the built extension at build time, and the
# build FAILS if a required value is missing/invalid (see env.config.ts).
#
#   npm run dev        -> mode "development": loads .env.development
#   npm run build:dev  -> mode "development": loads .env.development
#   npm run build      -> mode "production":  loads .env.production
#   npm run release:zip-> production build + zip for the Chrome Web Store
#
# ---------------------------------------------------------------------------
# Development (copy this section to .env.development)
# ---------------------------------------------------------------------------
# Same publishable key as apps/web's NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY —
# publishable keys are safe to embed in a built extension.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# The web app origin the extension syncs its session with (Clerk's syncHost).
# This is also the backend API base URL, and its host is excluded from job
# detection (so the floating button never appears on Job Jet's own dashboard).
VITE_CLERK_SYNC_HOST=http://localhost:3001

# ---------------------------------------------------------------------------
# Production (copy this section to .env.production, uncommented)
# ---------------------------------------------------------------------------
# A production build refuses to run if:
#   - VITE_CLERK_SYNC_HOST is localhost/127.0.0.1 or not https://
#   - VITE_CLERK_PUBLISHABLE_KEY is a development key (pk_test_...)
#
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
# VITE_CLERK_SYNC_HOST=https://your-deployed-web-app.example.com
#
# Escape hatch (NOT bundled into the extension; shell env or .env file):
# JOBJET_ALLOW_DEV_CONFIG=true  -> downgrade the production checks to warnings.
