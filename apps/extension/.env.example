# Job Jet extension environment.
#
# Vite inlines VITE_* values into the built extension at build time, and the
# build FAILS if a required value is missing/invalid (see env.config.ts).
#
#   npm run dev        -> mode "development": loads .env.development
#   npm run build:dev  -> mode "development": loads .env.development
#   npm run build      -> mode "production":  loads .env.production
#   npm run release:extension (repo root) -> production build + zip
#
# There are no secrets here: the extension signs in by connecting to your
# Job Jet web account (Better Auth), which hands it a session token at
# runtime via the web app's /extension-connect page.

# ---------------------------------------------------------------------------
# Development (copy this section to .env.development)
# ---------------------------------------------------------------------------
# The Job Jet web app origin (no path). Used for API calls, the sign-in /
# connect pages, externally_connectable (only this origin may hand the
# extension a token), and to exclude Job Jet's own pages from job detection.
VITE_API_BASE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Production (copy this section to .env.production, uncommented)
# ---------------------------------------------------------------------------
# A production build refuses to run if VITE_API_BASE_URL is localhost /
# 127.0.0.1 or not https://.
#
# VITE_API_BASE_URL=https://your-deployed-web-app.example.com
#
# Escape hatch (NOT bundled into the extension; shell env or .env file):
# JOBJET_ALLOW_DEV_CONFIG=true  -> downgrade the production checks to warnings.
